# AI Health Copilot Pro - Environment Configuration
# Copyright (c) 2025 Harry Patria - Patria & Co.
# Agentic AI Masterclass Project

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Application Configuration
APP_TITLE=AI Health Copilot Pro
APP_VERSION=1.0.0
DEBUG_MODE=False
LOG_LEVEL=INFO

# Performance Settings
ENABLE_LATENCY_TRACKING=True
MAX_RESPONSE_TIME_MS=3000
MODEL_CACHE_ENABLED=True

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=True

# Security Settings
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Feature Flags
ENABLE_AI_ANALYSIS=True
ENABLE_HEALTH_PLANNER=True
ENABLE_PERFORMANCE_METRICS=True
ENABLE_DARK_MODE=True

# Model Paths
MODELS_DIR=models
DATASETS_DIR=datasets
ASSETS_DIR=assets
LOGS_DIR=logs

# Database (if needed in future)
# DATABASE_URL=sqlite:///health_copilot.db

# Email (if notifications needed in future)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-password
